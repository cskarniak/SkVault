# Base de données (PostgreSQL local via docker, port 5434)
DATABASE_URL=postgresql://skvault:skvault@localhost:5434/skvault

# API
API_PORT=3011
API_HOST=
CORS_ORIGIN=http://localhost:3010

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3011/api
NEXT_PUBLIC_LAUNCHER_URL=https://apps.home

# Auth (JWT utilisateur, expiration 7j)
AUTH_SECRET=change-me-in-production

# Jeton partagé des agents de scan (header x-agent-token) — le même sur chaque machine scannée
AGENT_TOKEN=change-me-too

# Agent de scan (apps/agent) : URL de l'API centrale
SKVAULT_URL=http://localhost:3011/api
SKVAULT_AGENT_TOKEN=change-me-too
