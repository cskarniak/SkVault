<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Agent SkVault (macOS) : à copier dans ~/Library/LaunchAgents/, après avoir remplacé les 3 valeurs <REMPLACER>. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.skvault.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>cd "<REMPLACER chemin du dépôt SkVault>" &amp;&amp; exec pnpm agent run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SKVAULT_URL</key><string>https://skvault.home/api</string>
    <key>SKVAULT_AGENT_TOKEN</key><string><REMPLACER jeton></string>
    <!-- Certificat mkcert : l'autorité doit être connue de Node -->
    <key>NODE_EXTRA_CA_CERTS</key><string><REMPLACER chemin de rootCA.pem></string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/skvault-agent.log</string>
  <key>StandardErrorPath</key><string>/tmp/skvault-agent.log</string>
</dict>
</plist>
